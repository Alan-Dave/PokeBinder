# Plantilla de variables de entorno.
#
# 1. Copia este archivo como .env.local (git lo ignora).
# 2. Completa los valores desde el panel de Supabase:
#    Project Settings -> API Keys / Data API.
#
# Nunca escribas valores reales en este archivo: está versionado.

# URL del proyecto, por ejemplo https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave publicable (sb_publishable_... o la "anon" antigua).
# Puede llegar al navegador porque RLS limita lo que permite hacer.
# La clave secreta (sb_secret_... o service_role) NO va aquí: la app se niega a arrancar si la detecta.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave secreta (sb_secret_... o service_role). Sin el prefijo NEXT_PUBLIC_:
# nunca se incluye en el bundle del navegador. Solo la usan rutas de servidor
# que necesitan saltarse RLS, como firmar URLs de un bucket privado.
SUPABASE_SECRET_KEY=
