# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# variables de entorno: ninguna se versiona, salvo la plantilla sin valores
.env*
!.env.example

# base de datos del catálogo: pesa demasiado y se respalda aparte
*.db
*.sqlite
*.sqlite3

# python (scripts de ingesta)
__pycache__/
*.pyc
.venv/

# resultados de pruebas del pipeline
junit-results.xml

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
